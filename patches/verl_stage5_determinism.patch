         self.actor.set_loss_fn(loss_fn=loss_fn)
 
+    @register(dispatch_mode=Dispatch.ONE_TO_ALL)
+    def capture_validation_rng_state(self):
+        assert self.actor is not None, "actor must be initialized before validation"
+        manager = self.actor.engine.checkpoint_manager
+        self._dynamic_rubric_validation_rng_state = manager.get_rng_state()
+
+    @register(dispatch_mode=Dispatch.ONE_TO_ALL)
+    def restore_validation_rng_state(self):
+        assert self.actor is not None, "actor must be initialized before validation"
+        state = getattr(self, "_dynamic_rubric_validation_rng_state", None)
+        if state is None:
+            raise RuntimeError("validation RNG state was not captured")
+        self.actor.engine.checkpoint_manager.load_rng_state(state)
+        del self._dynamic_rubric_validation_rng_state
+
     @register(dispatch_mode=Dispatch.ONE_TO_ALL)
     def to(self, device, model=True, optimizer=True, grad=True):
         """Manual control of load/offload"""
