+def _resolve_ppo_mini_batch_size(
+    *, configured_prompt_batch_size: int, rollout_n: int, actual_response_batch_size: int
+) -> int:
+    """Keep one PPO mini-batch for a smaller, non-dropped final prompt batch."""
+
+    configured_response_batch_size = configured_prompt_batch_size * rollout_n
+    if configured_response_batch_size <= 0 or actual_response_batch_size <= 0:
+        raise ValueError("PPO batch sizes must be positive")
+    if actual_response_batch_size % rollout_n != 0:
+        raise ValueError(
+            f"response batch size {actual_response_batch_size} is not grouped by rollout.n={rollout_n}"
+        )
+    if actual_response_batch_size < configured_response_batch_size:
+        return actual_response_batch_size
+    if actual_response_batch_size % configured_response_batch_size != 0:
+        raise ValueError(
+            f"response batch size {actual_response_batch_size} is not divisible by configured "
+            f"PPO mini-batch size {configured_response_batch_size}"
+        )
+    return configured_response_batch_size
+
