+    def _load_online_step_hooks(self):
+        hook_config = self._online_step_hook_config()
+        if hook_config is None:
+            return None
+        cached = getattr(self, "_online_step_hooks", None)
+        if cached is not None:
+            return cached
+
+        path = hook_config.get("path")
+        prepare_name = hook_config.get("name")
+        commit_name = hook_config.get("commit_name", "commit_step")
+        if not path or not prepare_name:
+            raise RuntimeError("online_step_hook requires non-empty path and name")
+        custom_reward = self.config.reward.get("custom_reward_function") or {}
+        if custom_reward.get("path"):
+            raise RuntimeError(
+                "online_step_hook cannot run with the scalar custom reward loop; "
+                "online rewards must be prepared by the full-batch hook"
+            )
+        checkpoint_config = self.config.actor_rollout_ref.actor.checkpoint
+        if checkpoint_config.get("async_save", False):
+            raise RuntimeError("online_step_hook requires synchronous checkpoints")
+
+        runtime_config = self.config.reward.get("online_step_runtime") or {}
+        runtime_path = runtime_config.get("path")
+        runtime_name = runtime_config.get("name")
+        if not runtime_path or not runtime_name:
+            raise RuntimeError("online_step_runtime requires non-empty path and name")
+        runtime_factory = load_extern_object(module_path=runtime_path, object_name=runtime_name)
+        prepare = load_extern_object(module_path=path, object_name=prepare_name)
+        commit = load_extern_object(module_path=path, object_name=commit_name)
+        if not callable(runtime_factory) or not callable(prepare) or not callable(commit):
+            raise RuntimeError("online_step_hook runtime, prepare, and commit objects must be callable")
+        runtime = runtime_factory(config=self.config, trainer=self)
+        if runtime is None:
+            raise RuntimeError("online_step_hook runtime factory returned None")
+        self.online_reward_runtime = runtime
+        self._online_reward_runtime = runtime
+        cached = (prepare, commit)
+        self._online_step_hooks = cached
+        return cached
+
+    def _prepare_online_rewards(self, batch: DataProto) -> DataProto:
+        hooks = self._load_online_step_hooks()
+        if hooks is None:
+            return batch
+        if "rm_scores" in batch.batch:
+            raise RuntimeError("online_step_hook refuses precomputed rm_scores")
+
+        prepare, _ = hooks
+        prepared = prepare(batch=batch, global_step=self.global_steps, trainer=self)
+        if prepared is not None:
+            if not isinstance(prepared, DataProto):
+                raise RuntimeError("online reward hook must return DataProto or None")
+            batch = prepared
+
+        if "rm_scores" not in batch.batch:
+            raise RuntimeError("sealed online reward hook result is missing rm_scores")
+        rm_scores = batch.batch["rm_scores"]
+        responses = batch.batch["responses"]
+        if rm_scores.shape != responses.shape:
+            raise RuntimeError(
+                f"online rm_scores shape {tuple(rm_scores.shape)} must match responses "
+                f"shape {tuple(responses.shape)}"
+            )
+        if not torch.isfinite(rm_scores).all():
+            raise RuntimeError("online rm_scores must all be finite")
+
+        response_mask = batch.batch.get("response_mask")
+        if response_mask is None:
+            response_mask = compute_response_mask(batch)
+            batch.batch["response_mask"] = response_mask
+        valid_counts = response_mask.to(dtype=torch.long).sum(dim=-1)
+        if torch.any(valid_counts <= 0):
+            raise RuntimeError("online reward requires at least one valid response token per sample")
+        token_positions = torch.arange(
+            response_mask.shape[-1], device=response_mask.device
+        ).unsqueeze(0)
+        last_valid = torch.where(
+            response_mask.to(dtype=torch.bool), token_positions, -1
+        ).amax(dim=-1)
+        terminal_mask = torch.zeros_like(response_mask, dtype=torch.bool)
+        terminal_mask.scatter_(1, last_valid.unsqueeze(-1), True)
+        if torch.any(rm_scores.masked_select(~terminal_mask) != 0):
+            raise RuntimeError("online scalar rewards must be placed only at the last valid token")
+
+        trace_refs = batch.non_tensor_batch.get("online_trace_ref")
+        if trace_refs is None or len(trace_refs) != rm_scores.shape[0]:
+            raise RuntimeError("online reward hook must bind one online_trace_ref per response")
+        if any(not str(value) for value in trace_refs):
+            raise RuntimeError("online_trace_ref values must be non-empty")
+        if batch.meta_info.get("online_step_sealed") is not True:
+            raise RuntimeError("online reward hook result is not sealed")
+        if int(batch.meta_info.get("online_optimizer_update_index", -1)) != self.global_steps:
+            raise RuntimeError("online reward hook result is bound to the wrong optimizer step")
+        if not str(batch.meta_info.get("online_manifest_hash", "")):
+            raise RuntimeError("online reward hook result is missing its manifest hash")
+        return batch
+
+    def _commit_online_step(self, checkpoint_dir: str | None = None) -> None:
+        hooks = self._load_online_step_hooks()
+        if hooks is None:
+            return
+        _, commit = hooks
+        commit(global_step=self.global_steps, checkpoint_dir=checkpoint_dir, trainer=self)
