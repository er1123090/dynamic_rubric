+
+    def _rq2_config(self):
+        """Return the optional RQ2 observer configuration."""
+        if self.config is None:
+            return {}
+        cfg = self.config.get("rq2", {})
+        return cfg if cfg is not None else {}
+
+    def _rq2_enabled(self) -> bool:
+        cfg = self._rq2_config()
+        return bool(cfg.get("enabled", False)) if hasattr(cfg, "get") else False
+
+    def _emit_rq2(self, hook_name: str, *args) -> None:
+        """Call an opt-in external observer without changing EvoRubrics rewards."""
+        if not self._rq2_enabled():
+            return
+        if self._rq2_observer is None:
+            cfg = self._rq2_config()
+            module_name = cfg.get(
+                "observer_module", "dynamic_rubric.phase1.evorubrics_observer"
+            )
+            self._rq2_observer = importlib.import_module(str(module_name))
+        hook = getattr(self._rq2_observer, hook_name, None)
+        if hook is None:
+            raise AttributeError(
+                f"RQ2 observer {self._rq2_observer.__name__!r} has no {hook_name} hook"
+            )
+        hook(self, *args)
+
+    def _response_token_counts(self, output: DataProto) -> List[int]:
+        """Count non-padding rollout tokens for RQ2 accounting."""
+        if output is None or output.batch is None or "responses" not in output.batch:
+            return []
+        responses = output.batch["responses"]
+        pad_token_id = getattr(self.tokenizer, "pad_token_id", None)
+        if pad_token_id is None:
+            return [int(responses.shape[-1])] * int(responses.shape[0])
+        return [int(x) for x in (responses != pad_token_id).sum(dim=-1).cpu().tolist()]
+
+    @staticmethod
+    def _batch_values(batch: DataProto, key: str) -> List[Any]:
+        """Return a non-tensor batch field as a plain list."""
+        if batch.non_tensor_batch is None or key not in batch.non_tensor_batch:
+            return []
+        values = batch.non_tensor_batch[key]
+        if isinstance(values, np.ndarray):
+            return values.tolist()
+        return list(values)
 
