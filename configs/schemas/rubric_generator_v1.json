{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "rationale"],
        "properties": {
          "text": {"type": "string", "minLength": 12},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}

