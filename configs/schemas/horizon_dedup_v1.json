{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis",
    "final_criteria"
  ],
  "properties": {
    "analysis": {
      "type": "string"
    },
    "final_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "source_candidate_ids"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "source_candidate_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
